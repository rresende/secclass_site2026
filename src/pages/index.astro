---
import Email from '../components/Email.astro';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { site, publicacoes, url, link, totalTermos, fmt } from '../lib/data.js';

const v = site.versao_atual;
const recentes = publicacoes.slice(0, 4);
const nPub = publicacoes.length;
const apps = site.downloads.filter((d) => d.destaque);
const outros = site.downloads.filter((d) => !d.destaque);
---
<Base>
  <!-- Sistema de classificação -->
  <section class="hero">
    <div class="wrap">
      <span class="badge">Versão {v.numero} · {v.data}</span>
      <h1>O sistema de classificação da construção para Portugal</h1>
      <p class="lead">{site.nome_completo}. Adaptação aberta e gratuita do Uniclass 2015, alinhada com a EN&nbsp;ISO&nbsp;12006-2, para BIM e para todo o ciclo de vida do ambiente construído.</p>
      <div class="ctas">
        <a class="btn" href={url('/pesquisa/')}>Pesquisar termos</a>
        <a class="btn btn-ghost" href="#aplicacoes">Descarregar tabelas</a>
      </div>
      <div class="stats">
        <div class="stat"><b>{site.tabelas.length}</b><span>tabelas</span></div>
        <div class="stat"><b>{fmt(totalTermos)}</b><span>termos</span></div>
        <div class="stat"><b>{v.base.split('—')[1]?.trim() ?? v.base}</b><span>Uniclass de referência</span></div>
      </div>
    </div>
  </section>

  <!-- Aplicações em destaque -->
  <section class="section" id="aplicacoes">
    <div class="wrap">
      <p class="kicker">Aplicações</p>
      <h2>Pesquisar, descarregar e usar no software BIM</h2>
      <p class="intro">Versão {v.numero}. Todos os ficheiros estão versionados no <a href={site.repositorio_dados} rel="noopener">repositório público do SECClasS</a>.</p>
      <div class="apps">
        <a class="app" href={url('/pesquisa/')}>
          <span class="app-ico" aria-hidden="true">⌕</span>
          <h3>Pesquisa</h3>
          <p>Procure qualquer termo por código, título em português ou título Uniclass, com filtros por tabela e versão.</p>
          <span class="app-cta">Abrir pesquisa →</span>
        </a>
        {apps.map((d, i) => (
          <a class="app" href={d.url} rel="noopener">
            <span class="app-ico" aria-hidden="true">{['▦', 'R', 'A'][i] ?? '↓'}</span>
            <h3>{d.titulo}</h3>
            <p>{d.descricao}</p>
            <span class="app-cta">Descarregar · {d.formato} →</span>
          </a>
        ))}
      </div>

      <h3 style="margin-top:40px">Outros ficheiros</h3>
      <div class="grid">
        {outros.map((d) => d.url
          ? <a class="card card-link" href={d.url} rel="noopener"><span class="pill">{d.formato}</span><h3 style="margin-top:10px">{d.titulo}</h3><p>{d.descricao}</p></a>
          : <div class="card"><span class="pill pill-warn">{d.estado}</span><h3 style="margin-top:10px">{d.titulo}</h3><p>{d.descricao}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section-soft" id="tabelas">
    <div class="wrap">
      <p class="kicker">Estrutura</p>
      <h2>As {site.tabelas.length} tabelas do SECClasS</h2>
      <p class="intro">Os prefixos (Co, En, Ss, Pr…) são os do Uniclass: a correspondência entre os dois sistemas mantém-se através dos códigos. As sete primeiras formam uma hierarquia do macro ao micro (ambientes, sistemas e produtos); as restantes apoiam a gestão da informação.</p>
      <div class="tables">
        {site.tabelas.map((t) => (
          <div class="tcard">
            <div class="tcode">{t.codigo}</div>
            <div><h3>{t.nome} <small>{fmt(t.termos)} termos</small></h3><p>{t.descricao}</p></div>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top:20px">{site.tabelas_nota}</p>
    </div>
  </section>

  <!-- Atualizações -->
  <section class="section" id="versoes">
    <div class="wrap two-col">
      <div>
        <p class="kicker">Atualizações</p>
        <h2>Histórico de versões</h2>
        <p class="intro">A versão {v.numero} corresponde ao {v.base} e foi produzida por {v.autores}.</p>
        <p class="intro">Encontrou um termo em falta ou uma tradução a melhorar? Use a <a href={url('/pesquisa/')}>ferramenta de pesquisa</a>, abra uma <a href={`${site.repositorio_dados}/issues`} rel="noopener">issue no GitHub</a> ou escreva para <Email email={site.contactos.email_sugestoes} subject="Sugestão SECClasS" />.</p>
      </div>
      <ol class="timeline">
        {site.versoes.map((ver) => (
          <li>
            <h3>v{ver.numero} <span class="muted" style="font-weight:400">· {ver.data}</span></h3>
            <ul>{ver.alteracoes.map((a) => <li>{a}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-soft" id="recursos">
    <div class="wrap">
      <p class="kicker">Aprender e aplicar</p>
      <h2>Recursos</h2>
      <div class="grid">
        {site.recursos.map((r) => {
          const href = link(r);
          return href
            ? <a class="card card-link" href={href} rel="noopener"><h3>{r.titulo}</h3><p>{r.descricao}</p></a>
            : <div class="card"><h3>{r.titulo}</h3><p>{r.descricao}</p><p class="meta">Em actualização.</p></div>;
        })}
      </div>
    </div>
  </section>

  <!-- Trabalhos que aplicam SECClasS -->
  <section class="section" id="publicacoes">
    <div class="wrap">
      <p class="kicker">Investigação</p>
      <h2>Trabalhos que aplicam SECClasS</h2>
      <p class="intro">Artigos, comunicações, dissertações e relatórios que aplicam ou referem o SECClasS. A lista é atualizada de 15 em 15 dias a partir de repositórios universitários e congressos, com validação humana antes de publicar.</p>
      <div>
        {recentes.map((p) => (
          <article class="pub">
            <h3>{link(p) ? <a href={link(p)} rel="noopener">{p.titulo}</a> : p.titulo}</h3>
            <p class="authors">{p.autores.join(', ')}</p>
            <p class="venue">{p.local} · {p.ano}</p>
          </article>
        ))}
      </div>
      <p><a class="btn btn-outline" href={url('/publicacoes/')}>Ver todos ({nPub})</a></p>
    </div>
  </section>

  <!-- Manutenção + newsletter -->
  <section class="section section-dark" id="manutencao">
    <div class="wrap two-col">
      <div>
        <p class="kicker" style="color:var(--sand)">Quem mantém</p>
        <h2>Um sistema aberto e em atualização</h2>
        <p style="font-size:1.15rem">O SECClasS é mantido pela <a href={site.escola.url} rel="noopener">Escola de Tecnologias Digitais Aplicadas do Iscte Sintra</a>, com contributos técnicos da comunidade.</p>
        <p class="muted-light">Propostas de novos termos, correções de tradução e ficheiros para software BIM são revistos e integrados em versões numeradas, com registo público de alterações. <a href={`${site.repositorio_dados}/issues/new`} rel="noopener">Propor uma alteração →</a></p>
      </div>
      <Newsletter />
    </div>
  </section>

  <!-- O projeto financiado -->
  <section class="section" id="projeto">
    <div class="wrap">
      <p class="kicker">Origem</p>
      <h2>O projeto SECClasS (2020–2023)</h2>
      <p class="intro">{site.projeto.resumo}</p>

      <h3 style="margin-top:32px">Parceiros</h3>
      <div class="grid grid-sm">
        {site.parceiros.map((p) => (
          <a class="card card-link" href={p.url} rel="noopener"><h3>{p.nome}</h3><p>{p.descricao}</p></a>
        ))}
      </div>

      <h3 style="margin-top:40px">Equipa</h3>
      <ul class="team">
        {site.equipa.map((m) => <li>{m.nome} <span class="muted">— {m.inst}{m.papel ? `, ${m.papel.toLowerCase()}` : ''}</span></li>)}
      </ul>
      <p style="margin-top:24px"><a href={url('/arquivo/')}>Arquivo de Notícias do projeto →</a></p>

      <div class="funding">
        <a href={site.projeto.financiador.url} rel="noopener"><img src={url(site.projeto.financiador.logo)} alt="EEA Grants — Iceland, Liechtenstein, Norway" width="180" /></a>
        <div>
          <h3>Financiamento</h3>
          <p style="margin:0">Projeto financiado pelo <a href={site.projeto.financiador.url} rel="noopener">{site.projeto.financiador.nome}</a>. {site.projeto.financiador.texto}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
