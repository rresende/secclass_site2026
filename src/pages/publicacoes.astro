---
import Email from '../components/Email.astro';
import Base from '../layouts/Base.astro';
import { site, publicacoes, link, pdf, url } from '../lib/data.js';

const tipos = { artigo: 'Artigo', comunicacao: 'Comunicação', dissertacao: 'Dissertação', tese: 'Tese', relatorio: 'Relatório', livro: 'Livro' };
const grupos = [
  { id: 'terceiros', titulo: 'Trabalhos que aplicam o SECClasS', vazio: 'A primeira recolha automática está em curso. Conhece um trabalho que use o SECClasS? Envie-nos a referência.' },
  { id: 'projeto', titulo: 'Publicações do projeto SECClasS', vazio: '' },
];
---
<Base title="Publicações" description="Artigos científicos, dissertações e trabalhos que aplicam o sistema de classificação SECClasS.">
  <section class="section" style="padding-top:32px">
    <div class="wrap" style="max-width:900px">
      <p class="kicker"><a href={url('/')}>SECClasS</a> / Publicações</p>
      <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">Trabalhos que aplicam o SECClasS</h1>
      <p class="intro">Recolha de artigos científicos, comunicações, dissertações e relatórios que aplicam ou referem o SECClasS. A lista tem origem na pesquisa de repositórios universitários portugueses, congressos de BIM e bases bibliográficas.</p>
      {site.publicacoes_revisao && <p class="muted" style="font-size:.95rem">Última revisão da lista: {site.publicacoes_revisao}.</p>}
      <p class="muted">Falta algum trabalho? Escreva para <Email email="info@secclass.pt" subject="Publicação que aplica o SECClasS" />.</p>

      {grupos.map((g) => {
        const lista = publicacoes.filter((p) => (p.categoria ?? 'terceiros') === g.id);
        return (
          <section id={g.id} style="margin-top:40px">
            <h2>{g.titulo} <span class="muted" style="font-weight:400;font-size:1rem">({lista.length})</span></h2>
            {lista.length === 0 && <p class="muted">{g.vazio}</p>}
            {lista.map((p) => {
              const href = link(p);
              return (
                <article class="pub">
                  <p style="margin:0 0 4px"><span class="pill">{tipos[p.tipo] ?? p.tipo}</span><span class="pill">{p.ano}</span></p>
                  <h3>{href ? <a href={href} rel="noopener">{p.titulo}</a> : p.titulo}</h3>
                  <p class="authors">{p.autores.join(', ')}</p>
                  <p class="venue">{p.instituicao}{p.instituicao && p.local ? ' · ' : ''}{p.local}</p>
                  {p.resumo && <p>{p.resumo}</p>}
                  {p.papel_secclass && <p class="role"><strong>Papel do SECClasS:</strong> {p.papel_secclass}</p>}
                  <p class="links">{p.url && <a href={p.url} rel="noopener">{p.url.includes('doi.org') ? 'DOI' : 'Ver original'}</a>}{pdf(p) && <a href={pdf(p)}>PDF</a>}</p>
                  {!href && !p.ficheiro && <p class="meta muted" style="font-size:.85rem">Publicado nas atas do congresso (sem versão pública online).</p>}
                  {!href && p.ficheiro && <p class="meta muted" style="font-size:.85rem">Documento em migração para o novo site.</p>}
                </article>
              );
            })}
          </section>
        );
      })}
    </div>
  </section>
</Base>
